# =========================
# Stone FFA Discord Bot
# =========================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Guild ID for faster slash-command sync during development.
# Leave empty or remove for global commands in production.
GUILD_ID=

# Database (SQLite by default). For PostgreSQL later: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/stone_ffa.db

# Logging
LOG_LEVEL=INFO
LOG_CHANNEL_ID=

# Welcome system
WELCOME_CHANNEL_ID=
WELCOME_ROLE_ID=
AUTO_ROLE_ID=

# Staff / tickets
STAFF_ROLE_ID=
TICKET_CATEGORY_ID=
TICKET_SUPPORT_ROLE_ID=

# Moderation log channel (falls back to LOG_CHANNEL_ID if empty)
MOD_LOG_CHANNEL_ID=

# Minecraft server (placeholders – set your real values)
MINECRAFT_SERVER_IP=play.stoneffa.example
MINECRAFT_SERVER_PORT=25565
MINECRAFT_SERVER_NAME=Stone FFA

# Public links (placeholders)
STORE_URL=https://store.stoneffa.example
WEBSITE_URL=https://stoneffa.example
VOTE_URL=https://vote.stoneffa.example
DISCORD_INVITE=https://discord.gg/your-invite

# Branding
EMBED_COLOR=0x2F3136
EMBED_FOOTER=Stone FFA • Minecraft FFA
